---
export const prerender = false;
import AppLayout from '../../layouts/AppLayout.astro';

const { user } = Astro.locals;
const { id } = Astro.params;

if (!user) return Astro.redirect('/login');
---

<AppLayout title="Company Details">
  <div id="company-data" data-id={id}></div>
  <div class="p-6">
    <div class="mb-6">
      <a href="/companies" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-white transition-colors">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        Back to Companies
      </a>
    </div>

    <div id="company-header" class="flex items-start gap-6 mb-8">
      <div id="company-avatar" class="w-20 h-20 rounded-2xl bg-surface-container-highest flex items-center justify-center text-2xl font-bold text-gray-400">
        <span class="material-symbols-outlined text-4xl">domain</span>
      </div>
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-2">
          <h1 id="company-name" class="text-3xl font-bold text-white">Loading...</h1>
          <span id="company-industry-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-primary/10 text-primary border border-primary/20">--</span>
        </div>
        <p id="company-domain-display" class="text-gray-500 font-mono text-sm">--</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="openEditCompanyModal()" class="flex items-center gap-2 px-4 py-2 bg-surface-container text-xs font-mono text-white rounded border border-outline-variant/10 hover:bg-surface-container-high transition-colors">
          <span class="material-symbols-outlined text-[16px]">edit</span>
          Edit Company
        </button>
        <button class="flex items-center gap-2 px-4 py-2 bg-surface-container text-xs font-mono text-white rounded border border-outline-variant/10 hover:bg-surface-container-high transition-colors">
          <span class="material-symbols-outlined text-[16px]">more_vert</span>
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/5">
          <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Company Information</h2>
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-gray-500">category</span>
              <div>
                <p class="text-xs text-gray-500 font-mono uppercase">Industry</p>
                <p id="company-industry" class="text-white">--</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-gray-500">group</span>
              <div>
                <p class="text-xs text-gray-500 font-mono uppercase">Company Size</p>
                <p id="company-size" class="text-white">--</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-gray-500">attach_money</span>
              <div>
                <p class="text-xs text-gray-500 font-mono uppercase">Annual Revenue</p>
                <p id="company-revenue" class="text-white">--</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-gray-500">link</span>
              <div>
                <p class="text-xs text-gray-500 font-mono uppercase">Website</p>
                <p id="company-website" class="text-white">--</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-gray-500">language</span>
              <div>
                <p class="text-xs text-gray-500 font-mono uppercase">Domain</p>
                <p id="company-domain" class="text-white">--</p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/5">
          <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Tags</h2>
          <div id="company-tags" class="flex flex-wrap gap-2">
            <span class="text-gray-500 text-sm">No tags</span>
          </div>
        </div>

        <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/5">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider">Contacts</h2>
          </div>
          <div id="contacts-list" class="space-y-3">
            <p class="text-gray-500 text-sm">No contacts associated</p>
          </div>
        </div>

        <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/5">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider">Deals</h2>
          </div>
          <div id="deals-list" class="space-y-3">
            <p class="text-gray-500 text-sm">No deals associated</p>
          </div>
        </div>

        <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/5">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider">Activity</h2>
          </div>
          <div id="activity-list" class="space-y-4">
            <p class="text-gray-500 text-sm">No activity yet</p>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/5">
          <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Address</h2>
          <div id="company-address" class="space-y-2">
            <p class="text-gray-500 text-sm">No address on file</p>
          </div>
        </div>

        <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/5">
          <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Details</h2>
          <div class="space-y-3">
            <div>
              <p class="text-xs text-gray-500 font-mono uppercase">Created</p>
              <p id="company-created" class="text-white text-sm">--</p>
            </div>
            <div>
              <p class="text-xs text-gray-500 font-mono uppercase">Last Updated</p>
              <p id="company-updated" class="text-white text-sm">--</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="edit-company-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-background/60 backdrop-blur-md" onclick="closeEditCompanyModal()"></div>
    <div class="relative w-full max-w-lg bg-surface-container border border-outline-variant/20 rounded-xl shadow-2xl overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="px-6 py-5 border-b border-outline-variant/10 flex items-center justify-between sticky top-0 bg-surface-container z-10">
        <h2 class="text-lg font-headline font-bold text-white">Edit Company</h2>
        <button onclick="closeEditCompanyModal()" class="p-1 hover:bg-surface-container-high rounded transition-colors">
          <span class="material-symbols-outlined text-gray-400">close</span>
        </button>
      </div>
      <form id="edit-company-form" class="p-6 space-y-4">
        <div>
          <label class="block text-[11px] font-mono text-gray-400 uppercase tracking-widest mb-2">Company Name <span class="text-red-400">*</span></label>
          <input type="text" id="edit-company-name" name="name" required class="w-full bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm focus:ring-1 focus:ring-primary" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] font-mono text-gray-400 uppercase tracking-widest mb-2">Industry</label>
            <input type="text" id="edit-company-industry" name="industry" class="w-full bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm focus:ring-1 focus:ring-primary" />
          </div>
          <div>
            <label class="block text-[11px] font-mono text-gray-400 uppercase tracking-widest mb-2">Domain</label>
            <input type="text" id="edit-company-domain" name="domain" class="w-full bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm focus:ring-1 focus:ring-primary" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] font-mono text-gray-400 uppercase tracking-widest mb-2">Size</label>
            <select id="edit-company-size" name="size" class="w-full bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm focus:ring-1 focus:ring-primary cursor-pointer">
              <option value="">Select size</option>
              <option value="startup">Startup</option>
              <option value="small">Small</option>
              <option value="medium">Medium</option>
              <option value="large">Large</option>
              <option value="enterprise">Enterprise</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-mono text-gray-400 uppercase tracking-widest mb-2">Annual Revenue</label>
            <input type="number" id="edit-company-revenue" name="annual_revenue" class="w-full bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm focus:ring-1 focus:ring-primary" />
          </div>
        </div>
        <div>
          <label class="block text-[11px] font-mono text-gray-400 uppercase tracking-widest mb-2">Website</label>
          <input type="url" id="edit-company-website" name="website" class="w-full bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm focus:ring-1 focus:ring-primary" />
        </div>
        <div>
          <label class="block text-[11px] font-mono text-gray-400 uppercase tracking-widest mb-2">Tags</label>
          <input type="text" id="edit-company-tags" name="tags" class="w-full bg-surface-container-highest border-none rounded-lg px-4 py-3 text-sm focus:ring-1 focus:ring-primary" placeholder="enterprise, partner, tech" />
          <p class="text-[10px] text-gray-500 mt-1">Separate multiple tags with commas</p>
        </div>
        <div id="edit-form-error" class="hidden text-red-400 text-sm bg-red-400/10 p-3 rounded-lg"></div>
        <div class="flex justify-end gap-3 pt-4">
          <button type="button" onclick="closeEditCompanyModal()" class="px-4 py-2 text-sm font-mono text-gray-400 hover:text-white transition-colors">Cancel</button>
          <button type="submit" id="edit-form-submit-btn" class="px-6 py-2 bg-primary-container text-white text-sm font-mono rounded-lg hover:opacity-90 transition-opacity">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</AppLayout>

<script>
  const id = document.getElementById('company-data')?.dataset.id;
  let company: any = null;
  let contacts: any[] = [];
  let deals: any[] = [];

  async function loadCompany() {
    const token = getToken();
    if (!token) {
      window.location.href = '/login';
      return;
    }

    if (!id) {
      document.getElementById('company-name').textContent = 'Invalid company ID';
      return;
    }

    try {
      const res = await fetch(`/api/v1/companies/${id}`, {
        headers: { Authorization: `Bearer ${token}` }
      });

      if (!res.ok) {
        if (res.status === 404) {
          document.getElementById('company-name').textContent = 'Company not found';
        }
        return;
      }

      const { data } = await res.json();
      company = data;

      renderCompany();
      loadContacts();
      loadDeals();
      loadActivity();
    } catch (err) {
      console.error('Failed to load company:', err);
      document.getElementById('company-name').textContent = 'Failed to load company';
    }
  }

  async function loadContacts() {
    const token = getToken();
    if (!token) return;

    try {
      const res = await fetch(`/api/v1/persons?company_id=${id}&limit=50`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      const { data } = await res.json();
      contacts = data || [];
      renderContacts();
    } catch (err) {
      console.error('Failed to load contacts:', err);
    }
  }

  async function loadDeals() {
    const token = getToken();
    if (!token) return;

    try {
      const res = await fetch(`/api/v1/deals?company_id=${id}&limit=50`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      const { data } = await res.json();
      deals = data || [];
      renderDeals();
    } catch (err) {
      console.error('Failed to load deals:', err);
    }
  }

  async function loadActivity() {
    const token = getToken();
    if (!token) return;

    try {
      const res = await fetch(`/api/v1/timeline?entity_type=company&entity_id=${id}`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      const { data } = await res.json();
      renderActivity(data || []);
    } catch (err) {
      console.error('Failed to load activity:', err);
    }
  }

  function formatDate(dateStr?: string): string {
    if (!dateStr) return '--';
    return new Date(dateStr).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  }

  function formatRevenue(revenue: number): string {
    if (!revenue) return '--';
    if (revenue >= 1000000000) return `$${(revenue / 1000000000).toFixed(1)}B`;
    if (revenue >= 1000000) return `$${(revenue / 1000000).toFixed(1)}M`;
    if (revenue >= 1000) return `$${(revenue / 1000).toFixed(1)}K`;
    return `$${revenue}`;
  }

  function formatSize(size: string): string {
    const sizeMap: Record<string, string> = {
      'startup': 'Startup',
      'small': 'Small',
      'medium': 'Medium',
      'large': 'Large',
      'enterprise': 'Enterprise',
    };
    return sizeMap[size] || size || '--';
  }

  function renderCompany() {
    if (!company) return;

    document.getElementById('company-name').textContent = company.name || 'Unnamed Company';
    document.getElementById('company-industry-badge').textContent = company.industry || 'N/A';
    document.getElementById('company-domain-display').textContent = company.domain || 'No domain';
    document.getElementById('company-industry').textContent = company.industry || 'Not set';
    document.getElementById('company-size').textContent = formatSize(company.size);
    document.getElementById('company-revenue').textContent = formatRevenue(company.annual_revenue);
    document.getElementById('company-domain').textContent = company.domain || 'Not set';

    const websiteEl = document.getElementById('company-website');
    if (company.website) {
      websiteEl.innerHTML = `<a href="${company.website}" target="_blank" class="text-primary hover:text-primary/80 transition-colors">${company.website}</a>`;
    } else {
      websiteEl.textContent = 'Not set';
    }

    document.getElementById('company-created').textContent = formatDate(company.created_at);
    document.getElementById('company-updated').textContent = formatDate(company.updated_at);

    const tagsEl = document.getElementById('company-tags');
    if (company.tags && company.tags.length > 0) {
      tagsEl.innerHTML = company.tags.map((tag: string) =>
        `<span class="px-2 py-1 rounded text-xs font-mono bg-surface-container-high text-gray-300">${tag}</span>`
      ).join('');
    } else {
      tagsEl.innerHTML = '<span class="text-gray-500 text-sm">No tags</span>';
    }

    const addressEl = document.getElementById('company-address');
    if (company.address) {
      const parts = [];
      if (company.address.street) parts.push(company.address.street);
      if (company.address.city) parts.push(company.address.city);
      if (company.address.state) parts.push(company.address.state);
      if (company.address.postal_code) parts.push(company.address.postal_code);
      if (company.address.country) parts.push(company.address.country);
      if (parts.length > 0) {
        addressEl.innerHTML = parts.map((p: string) => `<p class="text-white text-sm">${p}</p>`).join('');
      } else {
        addressEl.innerHTML = '<p class="text-gray-500 text-sm">No address on file</p>';
      }
    } else {
      addressEl.innerHTML = '<p class="text-gray-500 text-sm">No address on file</p>';
    }
  }

  function renderContacts() {
    const listEl = document.getElementById('contacts-list');
    if (contacts.length === 0) {
      listEl.innerHTML = '<p class="text-gray-500 text-sm">No contacts associated</p>';
      return;
    }

    listEl.innerHTML = contacts.map((c: any) => `
      <div class="flex items-center gap-3 p-3 bg-surface-container-high rounded-lg">
        <div class="w-9 h-9 rounded-full bg-primary/20 flex items-center justify-center text-xs font-bold text-primary">
          ${(c.first_name?.[0] || '') + (c.last_name?.[0] || '') || '?'}
        </div>
        <div class="flex-1 min-w-0">
          <a href="/contacts/${c.id}" class="text-white text-sm font-medium hover:text-primary transition-colors truncate block">
            ${c.first_name} ${c.last_name}
          </a>
          <p class="text-xs text-gray-500 font-mono truncate">${c.email?.[0] || 'No email'}</p>
        </div>
        <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider bg-surface-container text-gray-400">${c.type || 'contact'}</span>
      </div>
    `).join('');
  }

  function renderDeals() {
    const listEl = document.getElementById('deals-list');
    if (deals.length === 0) {
      listEl.innerHTML = '<p class="text-gray-500 text-sm">No deals associated</p>';
      return;
    }

    listEl.innerHTML = deals.map((d: any) => `
      <div class="flex items-center gap-3 p-3 bg-surface-container-high rounded-lg">
        <div class="w-9 h-9 rounded-lg bg-green-500/20 flex items-center justify-center">
          <span class="material-symbols-outlined text-sm text-green-400">monetization_on</span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-white text-sm font-medium truncate">${d.title}</p>
          <p class="text-xs text-gray-500 font-mono">${d.stage_name || d.stage_id || 'Unknown stage'}</p>
        </div>
        <div class="text-right">
          <p class="text-white text-sm font-mono">${d.value ? formatRevenue(d.value) : '--'}</p>
        </div>
      </div>
    `).join('');
  }

  function renderActivity(activities: any[]) {
    const listEl = document.getElementById('activity-list');
    if (activities.length === 0) {
      listEl.innerHTML = '<p class="text-gray-500 text-sm">No activity yet</p>';
      return;
    }

    listEl.innerHTML = activities.map((a: any) => `
      <div class="flex items-start gap-3">
        <div class="w-2 h-2 mt-2 rounded-full bg-primary/50 flex-shrink-0"></div>
        <div class="flex-1 min-w-0">
          <p class="text-white text-sm">${a.description || a.action || 'Activity'}</p>
          <p class="text-xs text-gray-500 font-mono">${formatDate(a.created_at)}</p>
        </div>
      </div>
    `).join('');
  }

  function openEditCompanyModal() {
    if (!company) return;

    (document.getElementById('edit-company-name') as HTMLInputElement).value = company.name || '';
    (document.getElementById('edit-company-industry') as HTMLInputElement).value = company.industry || '';
    (document.getElementById('edit-company-domain') as HTMLInputElement).value = company.domain || '';
    (document.getElementById('edit-company-size') as HTMLSelectElement).value = company.size || '';
    (document.getElementById('edit-company-revenue') as HTMLInputElement).value = company.annual_revenue || '';
    (document.getElementById('edit-company-website') as HTMLInputElement).value = company.website || '';
    (document.getElementById('edit-company-tags') as HTMLInputElement).value = (company.tags || []).join(', ');

    document.getElementById('edit-company-modal').classList.remove('hidden');
  }

  function closeEditCompanyModal() {
    document.getElementById('edit-company-modal').classList.add('hidden');
  }

  function getToken(): string | null {
    const stored = localStorage.getItem('oscar_auth');
    if (stored) {
      const { token } = JSON.parse(stored);
      if (token) return token;
    }
    const cookies = Object.fromEntries(
      document.cookie.split('; ').map(c => c.split('='))
    );
    return cookies['oscar_token'] || null;
  }

  document.getElementById('edit-company-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    const submitBtn = document.getElementById('edit-form-submit-btn');
    const errorEl = document.getElementById('edit-form-error');

    const token = getToken();
    if (!token) return;

    errorEl.classList.add('hidden');
    submitBtn.setAttribute('disabled', 'true');
    submitBtn.textContent = 'Saving...';

    const payload: any = {
      name: formData.get('name'),
    };

    const industry = formData.get('industry') as string;
    const domain = formData.get('domain') as string;
    const size = formData.get('size') as string;
    const revenue = formData.get('annual_revenue') as string;
    const website = formData.get('website') as string;
    const tagsInput = formData.get('tags') as string;

    if (industry) payload.industry = industry;
    if (domain) payload.domain = domain;
    if (size) payload.size = size;
    if (revenue) payload.annual_revenue = parseFloat(revenue);
    if (website) payload.website = website;
    if (tagsInput) {
      payload.tags = tagsInput.split(',').map(t => t.trim()).filter(t => t.length > 0);
    }

    try {
      const res = await fetch(`/api/v1/companies/${id}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        const { data } = await res.json();
        company = data;
        renderCompany();
        closeEditCompanyModal();
      } else {
        const error = await res.json();
        let errorMsg = 'Failed to save company';
        if (error.error?.details) {
          errorMsg = error.error.details.map((d: any) => d.message || d.field).join(', ');
        } else if (error.error?.message) {
          errorMsg = error.error.message;
        }
        errorEl.textContent = errorMsg;
        errorEl.classList.remove('hidden');
      }
    } catch (err) {
      console.error('Failed to save company:', err);
      errorEl.textContent = 'An unexpected error occurred';
      errorEl.classList.remove('hidden');
    } finally {
      submitBtn.removeAttribute('disabled');
      submitBtn.textContent = 'Save Changes';
    }
  });

  (window as any).openEditCompanyModal = openEditCompanyModal;
  (window as any).closeEditCompanyModal = closeEditCompanyModal;

  loadCompany();
</script>
