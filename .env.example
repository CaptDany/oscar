# =============================================================================
# Oscar — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                    # development | production
APP_PORT=8080                          # HTTP server port
APP_SECRET=                            # Hex-encoded 32+ byte secret (generate: openssl rand -hex 32)
APP_BASE_URL=http://localhost:8080     # Public-facing API base URL
APP_FRONTEND_URL=http://localhost:4321 # Frontend URL (for CORS, redirects)
APP_HOST=0.0.0.0                       # Server bind address

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://oscar:oscar@localhost:5432/oscar?sslmode=disable
DATABASE_MAX_CONNS=25                  # Max connections in pool
DATABASE_MAX_IDLE=5                    # Max idle connections
DATABASE_MIN_CONNS=5                   # Min connections in pool
DATABASE_CONN_TTL=30m                  # Connection lifetime (Go duration)

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379       # Redis connection URL
REDIS_PASSWORD=                        # Redis password (leave blank if none)
REDIS_POOL_SIZE=10                     # Connection pool size
REDIS_POOL_TIMEOUT=5s                  # Pool timeout (Go duration)
REDIS_DB=0                             # Redis database number

# ── Storage (Cloudflare R2) ──────────────────────────────────────────────────
R2_ACCOUNT_ID=                         # R2 account ID
R2_ACCESS_KEY=                         # R2 access key ID
R2_SECRET_KEY=                         # R2 secret access key
R2_BUCKET=oscar                        # R2 bucket name
R2_PUBLIC_URL=                         # R2 public URL (for direct access)

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=localhost                    # SMTP server hostname
SMTP_PORT=587                          # SMTP port (1025 for MailHog)
SMTP_USER=                             # SMTP user
SMTP_PASS=                             # SMTP password
SMTP_FROM=noreply@oscar.local          # Default from address

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=                    # Twilio account SID
TWILIO_AUTH_TOKEN=                     # Twilio auth token
TWILIO_FROM_NUMBER=                    # Twilio phone number (E.164 format)

# ── OAuth ────────────────────────────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=                # Google OAuth client ID
OAUTH_GOOGLE_CLIENT_SECRET=            # Google OAuth client secret
OAUTH_APPLE_CLIENT_ID=                 # Apple OAuth client ID
OAUTH_APPLE_CLIENT_SECRET=             # Apple OAuth client secret (generated)
OAUTH_APPLE_TEAM_ID=                   # Apple Developer team ID
OAUTH_APPLE_KEY_ID=                    # Apple private key ID
OAUTH_APPLE_PRIVATE_KEY=               # Apple private key contents

# ── Telemetry / Observability ────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=           # OpenTelemetry OTLP endpoint (e.g. http://otel-collector:4318)
PROMETHEUS_PORT=9090                   # Prometheus metrics port

# ── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_EMAIL_SYNC=false               # Enable email sync feature
FEATURE_SMS=false                      # Enable SMS notifications
FEATURE_WHATSAPP=false                 # Enable WhatsApp notifications
FEATURE_API_KEYS=true                  # Enable API key authentication

# ── Frontend (Client-side) ───────────────────────────────────────────────────
PUBLIC_GOOGLE_MAPS_API_KEY=            # Google Maps API key (browser-side)
